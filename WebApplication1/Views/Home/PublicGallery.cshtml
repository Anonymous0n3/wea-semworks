@{
    ViewData["Title"] = "Galerie Widgetů";
}

<div class="text-center py-4 bg-light rounded-3 mb-4">
    <h1 class="display-6">Galerie veřejných widgetů</h1>
    <p class="text-muted">
        Prohlížejte widgety ostatních uživatelů • lajkujte • přidejte si je do svého dashboardu
    </p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Můj Dashboard</a>
</div>

<!-- FILTRY -->
<div class="row g-3 align-items-end mb-4">
    <div class="col-lg-3 col-md-6">
        <label class="form-label">Název widgetu</label>
        <input type="text" id="discoSearch" class="form-control" placeholder="Např. Počasí v Praze">
    </div>
    <div class="col-lg-3 col-md-6">
        <label class="form-label">Autor</label>
        <input type="text" id="discoAuthor" class="form-control" placeholder="Jméno nebo e-mail">
    </div>
    <div class="col-lg-2 col-md-6">
        <label class="form-label">Typ widgetu</label>
        <select id="discoType" class="form-select">
            <option value="">Všechny typy</option>
            <option value="CurrentWeather">Aktuální počasí</option>
            <option value="ForecastWeather">Předpověď počasí</option>
            <option value="CurrencyWidget">Měnový převodník</option>
            <option value="NewsWidget">Novinky</option>
            <option value="CountryInfoWidget">Informace o zemi</option>
            <option value="AppInfoWidget">Info o aplikaci</option>
        </select>
    </div>
    <div class="col-lg-2 col-md-6">
        <label class="form-label">Řadit podle</label>
        <select id="discoSort" class="form-select">
            <option value="date">Nejnovější</option>
            <option value="likes">Nejvíce liků</option>
        </select>
    </div>
    <div class="col-lg-2 col-md-12">
        <button class="btn btn-primary w-100" onclick="loadPublicList(1)">Hledat</button>
    </div>
</div>

<!-- SEZNAM WIDGETŮ -->
<div id="publicContainer" class="row g-4">
    <div class="col-12 text-center text-muted">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Načítám veřejné widgety...</p>
    </div>
</div>

<!-- STRÁNKOVÁNÍ -->
<div class="d-flex justify-content-center align-items-center mt-5 gap-3">
    <button class="btn btn-outline-secondary" onclick="changePage(-1)" id="prevBtn">Předchozí</button>
    <span class="fw-bold" id="pageIndicator">Strana 1</span>
    <button class="btn btn-outline-secondary" onclick="changePage(1)" id="nextBtn">Další</button>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/discovery.js"></script>
}